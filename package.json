    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "gray-matter": "4.0.3",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "lucide-react": "1.77.0",
    "maath": "0.10.8",
    "motion": "14.14.0",
    "next": "16.4.6",
    "next-mdx-remote": "6.0.0",
    "postprocessing": "6.39.6",
